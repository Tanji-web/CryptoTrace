# Ethereum data provider
ETHERSCAN_API_KEY=YOUR_API_KEY_HERE

# Frontend development origins
CORS_ORIGINS=http://localhost:3000,http://localhost:8080

# Trace limits
MAX_GRAPH_NODES=100
MAX_LIVE_API_CALLS=30
MAX_CANDIDATES_PER_WALLET=10
MAX_TRANSACTIONS_PER_SOURCE=100

# API protection
RATE_LIMIT_REQUESTS_PER_WINDOW=30
RATE_LIMIT_WINDOW_SECONDS=60

# Repeated-trace cache (0 disables)
TRACE_CACHE_TTL_SECONDS=30
